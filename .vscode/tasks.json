{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Spring Boot",
			"type": "shell",
			"command": "mvn",
			"args": [
				"spring-boot:run"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run Vite dev server",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"user-web",
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}